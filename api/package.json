        "pg": "^8.13.1",
        "zod": "^3.24.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.17.0",
        "@types/node": "^22.10.2",
        "@types/pg": "^8.11.10",
        "eslint": "^9.17.0",
        "tsx": "^4.19.2",
