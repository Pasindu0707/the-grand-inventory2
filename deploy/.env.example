# Copy to deploy/.env on the server and fill in. Never commit the real file.
#
#   cp deploy/.env.example deploy/.env
#   nano deploy/.env
#
# deploy/.env is git-ignored. If you ever find it in a commit, rotate
# JWT_SECRET and the database password immediately -- both are in the history
# from that point on, and deleting the file later does not remove them.

# --- Public address -----------------------------------------------------
# SITE_ADDRESS drives Caddy. Two forms:
#   inventory.thegrand.lk   HTTPS with an automatic Let's Encrypt certificate.
#                           DNS must already point at this server, or the
#                           certificate request fails.
#   :80                     Plain HTTP on the raw Oracle IP. Use this for the
#                           first smoke test, before DNS is pointed here.
SITE_ADDRESS=:80

# The browser-facing URL. With SITE_ADDRESS=:80 during testing, use
# http://<your-oracle-public-ip>
PUBLIC_URL=http://your-oracle-ip-here

# --- Database -----------------------------------------------------------
POSTGRES_USER=grand
POSTGRES_DB=thegrand
# Generate, do not invent:  openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME

# --- Application secrets ------------------------------------------------
# Generate:  openssl rand -base64 48
# Rotating this invalidates every session, which is the intended lever if a
# device is lost. The API refuses to start in production if this is left as
# the development default.
JWT_SECRET=CHANGE_ME

ACCESS_TOKEN_TTL=12h
REFRESH_TOKEN_TTL=30d
MAX_PIN_ATTEMPTS=5
PIN_LOCKOUT_MINUTES=15
MAX_UPLOAD_BYTES=8388608

# --- Postgres memory ----------------------------------------------------
# Sized for the 12 GB Oracle A1 shape. This is also what keeps the instance
# from looking idle to Oracle's reclamation check -- see deploy/README.md.
# On a smaller machine (a 1 GB Vultr box) drop these to 256MB / 768MB.
PG_SHARED_BUFFERS=3GB
PG_EFFECTIVE_CACHE=6GB

# --- Backups (optional but strongly recommended) ------------------------
# Where deploy/backup.sh writes nightly dumps before uploading.
BACKUP_DIR=/opt/thegrand/backups
BACKUP_KEEP_DAYS=14
# An rclone remote name, configured with `rclone config` on the server.
# Leave empty to keep backups on the server only -- which is not a backup,
# because a lost server loses them with it.
RCLONE_REMOTE=
